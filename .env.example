# 2captcha account
TWOCAPTCHA_API_KEY=

# MCP server
TWOCAPTCHAMCP_ADDRESS=127.0.0.1:8080
TWOCAPTCHAMCP_TOKEN=

# Optional
# TWOCAPTCHA_BASE_URL=https://api.2captcha.com
# TWOCAPTCHA_SOFT_ID=
# TWOCAPTCHAMCP_MAX_RETRIES=5
# TWOCAPTCHAMCP_TIMEOUT=180s

# uncloud deployment only: public hostname for the MCP endpoint (TLS handled by uncloud's
# built-in ingress; the app itself still enforces TWOCAPTCHAMCP_TOKEN as a bearer token)
TWOCAP_DOMAIN=notabot.aresa.me
